QMainWindow {
    background: #f5f6f8;
}

QLabel#infoLabel {
    color: #1f2328;
    font-weight: bold;
}

QTableWidget {
    background: #ffffff;
    alternate-background-color: #fafbfc;
    gridline-color: #e6e8eb;
    border: 1px solid #d9dce1;
    border-radius: 4px;
    color: #1f2328;
}

QTableWidget::item {
    padding: 2px 4px;
}

QTableWidget::item:selected {
    background: #2f6fed;
    color: #ffffff;
}

QHeaderView::section {
    background: #eef0f3;
    color: #1f2328;
    padding: 5px;
    border: none;
    border-bottom: 1px solid #d0d4da;
    font-weight: bold;
}

QPushButton {
    padding: 3px 12px;
    border: 1px solid #c4c9d0;
    border-radius: 4px;
    background: #ffffff;
    color: #1f2328;
}

QPushButton:hover {
    background: #e8f0fe;
    border-color: #7fb0e8;
}

QPushButton:pressed {
    background: #d6e4f7;
}

QPushButton:disabled {
    color: #9aa0a8;
}

QPushButton#btnBind {
    color: #1a7f37;
}

QPushButton#btnAttach {
    color: #0969da;
}

QPushButton#btnDetach {
    color: #b35900;
}

QPushButton#btnUnbind {
    color: #cf222e;
}

QComboBox, QLineEdit {
    background: #ffffff;
    color: #1f2328;
    border: 1px solid #c4c9d0;
    border-radius: 4px;
    padding: 2px 6px;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    color: #1f2328;
    selection-background-color: #2f6fed;
    selection-color: #ffffff;
    border: 1px solid #c4c9d0;
}

QCheckBox {
    color: #1f2328;
}

QLabel#previewLabel {
    color: #57606a;
}

QPlainTextEdit#logView {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    background: #f6f8fa;
    color: #24292f;
    border: 1px solid #d0d7de;
    border-radius: 4px;
}
